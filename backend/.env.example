# Copie para .env e preencha em produção. Nunca comite o .env real.

GOTUR_DEBUG=false
GOTUR_JWT_SECRET=troque-por-uma-string-aleatoria-longa
GOTUR_CORS_ORIGINS=*

# Opcional: banco em produção (senão usa o sqlite local em backend/gotur.db)
# GOTUR_DATABASE_URL=postgresql://usuario:senha@host/banco

# Opcional (Fase 5): e-mail de confirmação de compra
# GOTUR_SMTP_HOST=smtp.sendgrid.net
# GOTUR_SMTP_PORT=587
# GOTUR_SMTP_USER=apikey
# GOTUR_SMTP_PASSWORD=xxxx
# GOTUR_SMTP_FROM=naoresponda@suaviacao.com

# Opcional (Fase 5): gateway de pagamento real
# GOTUR_GATEWAY_API_KEY=xxxx

# Opcional: notificação por WhatsApp via Evolution API (self-hosted)
# GOTUR_EVOLUTION_API_URL=https://sua-evolution.exemplo.com
# GOTUR_EVOLUTION_API_KEY=xxxx
# GOTUR_EVOLUTION_INSTANCE=nome-da-instancia
